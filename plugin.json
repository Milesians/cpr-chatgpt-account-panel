{
  "manifestVersion": 2,
  "name": "cpr-chatgpt-account-panel",
  "displayName": "ChatGPT 账号面板",
  "publisher": "milesians",
  "version": "0.1.0",
  "description": "按账号查看 ChatGPT 官方用量（按使用位置，重点看 Work）、订阅与账单、登录设备",
  "license": "MIT",
  "author": "Milesians",
  "engines": {
    "codex-proxy-rs": ">=3.34.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {
      "version": 2
    }
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "encryptionKey": {
        "type": "string",
        "description": "AES-256-GCM 凭据加密密钥（32 字节 Base64/Hex 密钥，或 kid:base64key 多密钥格式）"
      },
      "encryptionKeys": {
        "type": "string",
        "description": "AES-256-GCM 凭据加密密钥环（kid1:base64key1,kid2:base64key2）"
      },
      "activeKey": {
        "type": "string",
        "description": "当前用于加密新凭据的密钥 ID（单密钥时可留空）"
      },
      "oauthRedirect": {
        "type": "string",
        "description": "OAuth 回调地址（默认 http://localhost:1455/auth/callback）"
      }
    },
    "additionalProperties": false
  },
  "secretFields": [
    "encryptionKey",
    "encryptionKeys"
  ],
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  },
  "state": [
    {
      "namespace": "usage",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 2000,
      "maximumBytes": 4194304,
      "maximumValueBytes": 16384,
      "migratesFrom": []
    },
    {
      "namespace": "payments",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 2000,
      "maximumBytes": 2097152,
      "maximumValueBytes": 4096,
      "migratesFrom": []
    },
    {
      "namespace": "login",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 2000,
      "maximumBytes": 4194304,
      "maximumValueBytes": 16384,
      "migratesFrom": []
    }
  ]
}
