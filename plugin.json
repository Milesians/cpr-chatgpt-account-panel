{
  "manifestVersion": 2,
  "name": "cpr-chatgpt-account-panel",
  "displayName": "ChatGPT 账号面板",
  "publisher": "milesians",
  "version": "0.1.0",
  "description": "按账号查看 ChatGPT 官方用量（按使用位置，重点看 Work）、订阅与账单、登录设备",
  "license": "MIT",
  "author": "Milesians",
  "engines": {
    "codex-proxy-rs": ">=3.34.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {
      "version": 2
    }
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "cprAdminUrl": {
        "type": "string",
        "title": "CPR 地址（导入新账号复用代理用）",
        "description": "插件连 CPR 管理接口的地址，如 http://127.0.0.1:8080；导入新账号时用它调 oauth/start 与 oauth/complete 以绑定借道账号的出站代理",
        "maxLength": 512,
        "default": ""
      },
      "cprAdminApiKey": {
        "type": "string",
        "title": "CPR 管理 API Key（敏感字段）",
        "description": "CPR 设置里生成的管理 API Key；插件只用它读借道账号的代理并完成新账号 OAuth 导入。通过 CPR 独立敏感配置保存",
        "maxLength": 512
      },
      "oauthRedirect": {
        "type": "string",
        "description": "OAuth 回调地址（默认 http://localhost:1455/auth/callback）"
      }
    },
    "additionalProperties": false
  },
  "secretFields": [
    "cprAdminApiKey"
  ],
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  },
  "state": [
    {
      "namespace": "usage",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 2000,
      "maximumBytes": 4194304,
      "maximumValueBytes": 16384,
      "migratesFrom": []
    },
    {
      "namespace": "payments",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 2000,
      "maximumBytes": 2097152,
      "maximumValueBytes": 4096,
      "migratesFrom": []
    },
    {
      "namespace": "login",
      "schemaVersion": 1,
      "schema": { "type": "object" },
      "maximumRecords": 2000,
      "maximumBytes": 4194304,
      "maximumValueBytes": 16384,
      "migratesFrom": []
    }
  ]
}
